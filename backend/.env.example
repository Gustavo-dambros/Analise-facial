DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./facial_analysis.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/facial_analysis
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SUPABASE_URL=https://lchmfruaaukeqorfmwvg.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM=HS256
# Supabase Auth (cadastro via supabase.auth.sign_up)
SUPABASE_ANON_KEY=sua_anon_key_do_supabase
# Necessario para sincronizar confirmacao/senha (admin API)
SUPABASE_SERVICE_ROLE_KEY=
# Para onde o link de confirmacao do e-mail aponta
SUPABASE_EMAIL_REDIRECT_TO=https://facemax.pro/email-confirmado
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://facemax.pro","https://www.facemax.pro"]

# Database pool (production)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Rate limiting
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_ANALYSIS=10/hour
RATE_LIMIT_GENERAL=60/minute

# OpenRouter AI
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=30
OPENROUTER_REFERER=https://facemax.app

# Request limits
MAX_IMAGE_BASE64_SIZE_MB=10

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token-here
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret-here

# SMTP Email (Gmail — requires App Password with 2FA enabled)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_aplicativo
MAIL_FROM_EMAIL=FaceMax <noreply@facemax.app>
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
