# ============================================================
# FaceMax - Producao Environment Variables (.env.production)
# ============================================================

# PostgreSQL
POSTGRES_DB=facemax
POSTGRES_USER=facemax
POSTGRES_PASSWORD=GENERATE_A_STRONG_PASSWORD
POSTGRES_PORT=5432
# DATABASE_URL — for Render web service (set directly, not via POSTGRES vars)
DATABASE_URL=postgresql+asyncpg://facemax:GENERATE_A_STRONG_PASSWORD@db-hostname:5432/facemax

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8000
SECRET_KEY=GENERATE_WITH_python_-_c_import_secrets_--_print_secrets_token_urlsafe_64_
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=https://facemax.app

# Supabase (for JWT validation and Auth signup)
SUPABASE_URL=https://lchmfruaaukeqorfmwvg.supabase.co
SUPABASE_ANON_KEY=GET_FROM_SUPABASE_PROJECT_SETTINGS_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=GET_FROM_SUPABASE_PROJECT_SETTINGS_SERVICE_ROLE
SUPABASE_JWT_SECRET=GET_FROM_SUPABASE_PROJECT_SETTINGS_JWT_SECRET
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_EMAIL_REDIRECT_TO=https://facemax.pro/email-confirmado

# Rate limiting
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_ANALYSIS=10/hour
RATE_LIMIT_GENERAL=60/minute

# OpenRouter AI
OPENROUTER_API_KEY=GET_FROM_OPENROUTER_AI
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=30
OPENROUTER_REFERER=https://facemax.app

# SMTP Email
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=GET_APP_PASSWORD_FROM_GMAIL_WITH_2FA
MAIL_FROM_EMAIL=FaceMax <noreply@facemax.app>
BASE_URL=https://facemax.app

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=https://facemax.app/api/v1
VITE_SUPABASE_URL=https://lchmfruaaukeqorfmwvg.supabase.co
VITE_SUPABASE_ANON_KEY=GET_FROM_SUPABASE_PROJECT_SETTINGS_ANON_KEY
